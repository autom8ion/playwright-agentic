# Copy this file to env/.env and fill in real values. env/.env is gitignored.

BASE_URL=https://demoqa.com
API_URL=https://demoqa.com

# Created by `npm run setup:user` (see scripts/setup-test-user.ts).
# demoqa passwords must be 8+ chars with upper, lower, number, and special char.
#
# Two separate accounts on purpose: demoqa allows only one active token per
# account, so a UI login and a later API GenerateToken call on the *same*
# account invalidate each other. One account backs auth.setup.ts's browser
# storage state; the other backs the apiSession/apiRequest fixture.
DEMOQA_USERNAME=
DEMOQA_PASSWORD=
DEMOQA_API_USERNAME=
DEMOQA_API_PASSWORD=
